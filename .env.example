# Copiá este archivo como .env.local (está ignorado por Git) y completá estos datos.
# Creá un cliente OAuth de tipo "Aplicación de escritorio" en Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-client-secret

# La API Google Sheets debe estar habilitada en el mismo proyecto de Google Cloud.
GOOGLE_SHEET_ID=1_mRxlhoKZrQoRMi9rCDkg_0dn-FJ8O3EaoNKU-3pnRA
# Cambiá el nombre de la pestaña si en Google Forms se llama distinto.
GOOGLE_SHEET_RANGE=Form Responses 1!A:H

# Opcional: para ejecuciones no interactivas. No guardar este valor en archivos ni Git.
# GOOGLE_SHEETS_ACCESS_TOKEN=
